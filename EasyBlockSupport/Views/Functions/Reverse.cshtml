@model EasyBlockSupport.Models.DTOs.ContributionReverseDTO

@{
    ViewData["Title"] = "Reverse Transaction";
    bool hasResult = Model != null && Model.ContributionId > 0;
    string searchTerm = ViewBag.SearchTerm as string ?? "";
    string viewErrorMessage = ViewBag.ErrorMessage as string;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">

            @* ============================================================ *@
            @* STEP 1 — SEARCH BOX (always visible)                         *@
            @* ============================================================ *@
            <div class="card card-warning">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-undo-alt me-2"></i>
                        Find Transaction to Reverse
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> This action will create a reversal transaction
                        (negative amount) to cancel out the original transaction.
                        The original transaction will be marked as "REVERSED" but NOT deleted.
                    </div>

                    <form asp-action="Reverse" method="get" id="searchForm">
                        <div class="form-group mb-3">
                            <label class="control-label">
                                <i class="fas fa-receipt me-1"></i> Receipt Number / Transaction Number
                            </label>
                            <div class="input-group">
                                <input type="text" name="searchTerm" id="searchTerm"
                                       class="form-control form-control-lg"
                                       placeholder="Enter Receipt No or Transaction No..."
                                       value="@searchTerm" required autocomplete="off" />
                                <button type="submit" class="btn btn-warning btn-lg" id="searchBtn">
                                    <i class="fas fa-search me-1"></i> Search
                                </button>
                            </div>
                            <small class="form-text text-muted">
                                Example: REC052814434 or CONT-20241201-1234
                            </small>
                        </div>
                    </form>

                    @* Search-time error (not found / already reversed) *@
                    @if (!string.IsNullOrEmpty(viewErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            @viewErrorMessage
                        </div>
                    }
                </div>
            </div>

            @* ============================================================ *@
            @* STEP 2 — CONFIRMATION PANEL (only when a transaction found)  *@
            @* ============================================================ *@
            @if (hasResult)
            {
                <div class="card card-danger mt-3">
                    <div class="card-header">
                        <h3 class="card-title mb-0">
                            <i class="fas fa-undo-alt me-2"></i>
                            Confirm Transaction Reversal
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Warning:</strong> This action will create a reversal transaction
                            with NEGATIVE amount. The original transaction will be marked as
                            reversed but NOT deleted.
                        </div>

                        <!-- Transaction Details Card -->
                        <div class="card mb-3">
                            <div class="card-header bg-secondary">
                                <h5 class="mb-0">Transaction Details</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <table class="table table-sm table-borderless">
                                            <tr>
                                                <td><strong>Receipt No:</strong></td>
                                                <td>@Model.ReceiptNo</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Member No:</strong></td>
                                                <td>@Model.MemberNo</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Member Name:</strong></td>
                                                <td>@Model.MemberName</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Share Type:</strong></td>
                                                <td>@Model.ShareTypeName</td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <table class="table table-sm table-borderless">
                                            <tr>
                                                <td><strong>Amount:</strong></td>
                                                <td class="text-danger fw-bold">@Model.Amount?.ToString("N2")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Transaction Date:</strong></td>
                                                <td>@Model.TransactionDate?.ToString("dd-MMM-yyyy HH:mm")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Created By:</strong></td>
                                                <td>@Model.CreatedBy</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Blockchain Tx:</strong></td>
                                                <td>
                                                    <small class="text-muted">
                                                        @(Model.BlockchainTxId?.Substring(0, Math.Min(20, Model.BlockchainTxId?.Length ?? 0)) ?? "N/A")...
                                                    </small>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reversal Details -->
                        <div class="card mb-3">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0">Reversal Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>What will happen:</strong>
                                    <ul class="mb-0 mt-2">
                                        <li>A new reversal transaction with <strong>NEGATIVE @Model.Amount?.ToString("N2")</strong> will be created</li>
                                        <li>The original transaction will be marked as "REVERSED"</li>
                                        <li>Member's wallet balance will be reduced by @Model.Amount?.ToString("N2")</li>
                                        <li>Share balance will be decreased accordingly</li>
                                        <li>GL reversal entry will be created (swapped DR/CR)</li>
                                        <li>Blockchain reversal record will be added</li>
                                    </ul>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="ReverseReason" class="control-label fw-bold">
                                        <i class="fas fa-pen me-1"></i> Reason for Reversal
                                        <span class="text-danger">*</span>
                                    </label>
                                    <textarea asp-for="ReverseReason" id="reason" class="form-control" rows="3"
                                              placeholder="Please provide a detailed reason for reversing this transaction..."></textarea>
                                    <span asp-validation-for="ReverseReason" class="text-danger"></span>
                                    <small class="form-text text-muted">
                                        This reason will be recorded in the audit trail and reversal remarks.
                                    </small>
                                </div>

                                <div class="form-group mb-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="confirmReverse" />
                                        <label class="form-check-label" for="confirmReverse">
                                            I confirm that I want to reverse this transaction.
                                            This action cannot be undone.
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group text-center">
                                    <a asp-action="Reverse" class="btn btn-secondary">
                                        <i class="fas fa-times me-1"></i> Cancel / New Search
                                    </a>
                                    <button type="button" class="btn btn-danger" id="submitBtn" disabled>
                                        <i class="fas fa-undo-alt me-1"></i> Confirm Reversal
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<!-- Full-screen loading overlay (matches Index / Delete / Journal pages) -->
<div id="loadingOverlay"
     style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.5); z-index:9999; text-align:center; padding-top:20%;">
    <div class="spinner-border text-light" style="width:3rem; height:3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <div class="text-light mt-2" id="loadingMessage">Processing...</div>
</div>

@* Single antiforgery token that the JS will clone into the dynamic POST form *@
@Html.AntiForgeryToken()

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // ============================================================
        // HELPERS
        // ============================================================
        function showLoading(show, message) {
            if (show) {
                $('#loadingMessage').text(message || 'Processing...');
                $('#loadingOverlay').fadeIn(150);
            } else {
                $('#loadingOverlay').fadeOut(150);
            }
        }

        function escapeHtml(text) {
            if (text === null || text === undefined) return '';
            const div = document.createElement('div');
            div.textContent = String(text);
            return div.innerHTML;
        }

        function formatNumber(n) {
            if (n === null || n === undefined) return '';
            return Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // ============================================================
        // WIRING
        // ============================================================
        $(document).ready(function () {

            // Enable submit button when the confirmation checkbox is ticked
            $('#confirmReverse').on('change', function () {
                $('#submitBtn').prop('disabled', !this.checked);
            });

            // ------------------------------
            // SEARCH: intercept form submit → spinner → then submit
            // ------------------------------
            $('#searchForm').on('submit', function (e) {
                const term = $('#searchTerm').val().trim();
                if (!term) {
                    e.preventDefault();
                    Swal.fire('Input required', 'Please enter a receipt or transaction number.', 'warning');
                    return;
                }
                // Show spinner, then let the GET proceed
                showLoading(true, 'Searching for transaction...');
                // Do NOT prevent default — browser will navigate and the spinner
                // disappears naturally when the new page paints.
            });

            // ------------------------------
            // REVERSE: intercept button click → SweetAlert → POST via hidden form
            // ------------------------------
            $('#submitBtn').on('click', async function () {
                const reason = $('#reason').val().trim();

                if (!reason) {
                    Swal.fire('Reason required',
                        'Please provide a reason for reversing this transaction.',
                        'warning');
                    return;
                }

                @if (hasResult)
                {
                        <text>
                        const receiptNo  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReceiptNo ?? ""));
                        const memberNo   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MemberNo ?? ""));
                        const memberName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MemberName ?? ""));
                        const amount     = @(Model.Amount ?? 0);
                        const contributionId = @Model.ContributionId;
                        </text>
                }

                const result = await Swal.fire({
                    title: 'Reverse this transaction?',
                    html: `
                        <p>You are about to create a <strong>reversal transaction</strong> for:</p>
                        <table class="table table-sm text-start mt-2">
                            <tr><td><strong>Receipt:</strong></td><td>${escapeHtml(receiptNo)}</td></tr>
                            <tr><td><strong>Member:</strong></td><td>${escapeHtml(memberName || memberNo)}</td></tr>
                            <tr><td><strong>Amount:</strong></td><td>${formatNumber(amount)}</td></tr>
                            <tr><td><strong>Reason:</strong></td><td>${escapeHtml(reason)}</td></tr>
                        </table>
                        <p class="text-danger mb-0">The original transaction will be marked REVERSED
                        but will not be deleted.</p>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, reverse it',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: true
                });

                if (!result.isConfirmed) return;

                // Build a hidden form that posts to the Reverse POST action
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '@Url.Action("Reverse", "Functions")';
                form.style.display = 'none';

                // Antiforgery token — clone from the hidden token rendered at the bottom
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    form.appendChild(tokenInput.cloneNode(true));
                }

                const fields = {
                    ContributionId: contributionId,
                    ReceiptNo:      receiptNo,
                    MemberNo:       memberNo,
                    MemberName:     memberName,
                    Amount:         amount,
                    ReverseReason:  reason
                };

                for (const [name, value] of Object.entries(fields)) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = value ?? '';
                    form.appendChild(input);
                }

                document.body.appendChild(form);

                showLoading(true, 'Reversing transaction...');
                form.submit();
            });

            // ============================================================
            // TOASTS FROM TempData
            // ============================================================
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])),
                        showConfirmButton: false,
                        timer: 4000,
                        timerProgressBar: true
                    });
                    </text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                    <text>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"])),
                        showConfirmButton: false,
                        timer: 5000,
                        timerProgressBar: true
                    });
                    </text>
            }
        });
    </script>
}