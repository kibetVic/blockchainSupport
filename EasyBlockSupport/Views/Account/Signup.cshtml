@model EasyBlockSupport.Models.ViewModels.SignupVm
@{
    ViewData["Title"] = "Sign Up";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/AdminLte/dist/assets/img/Easyblock.png" />
    <title>Sign Up - EasySacco BlockChain System</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            background: #f5f7fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .signup-container {
            width: 100%;
            max-width: 1000px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .signup-row {
            display: flex;
            min-height: 700px;
        }

        /* Right side - Form Section */
        .form-section {
            flex: 1.5;
            background: white;
            padding: 30px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 700px;
        }

        .brand-title {
            color: #164799;
            font-weight: 700;
            margin-bottom: 5px;
            text-align: center;
        }

        .brand-subtitle {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 20px;
            text-align: center;
        }

        .form-section-title {
            color: #00AEEF;
            font-size: 1rem;
            font-weight: 600;
            margin: 15px 0 10px 0;
            padding-bottom: 5px;
            border-bottom: 2px solid #00AEEF;
        }

        .form-control, .form-select {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 0.9rem;
            transition: all 0.3s;
            height: 38px;
        }

        textarea.form-control {
            height: auto;
        }

        .form-control:focus, .form-select:focus {
            border-color: #00AEEF;
            box-shadow: 0 0 0 0.2rem rgba(0, 174, 239, 0.15);
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: 3px;
        }

        .input-group-text {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-right: none;
            padding: 0 12px;
        }

        .btn-signup {
            background: linear-gradient(145deg, #00AEEF, #164799);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 600;
            font-size: 0.95rem;
            color: white;
            transition: all 0.3s;
        }

            .btn-signup:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0, 174, 239, 0.2);
                color: white;
            }

        .btn-outline-secondary {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 10px 20px;
            font-size: 0.95rem;
            font-weight: 500;
        }

            .btn-outline-secondary:hover {
                background: #f8f9fa;
                border-color: #00AEEF;
            }

        .login-link {
            color: #00AEEF;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
        }

            .login-link:hover {
                text-decoration: underline;
            }

        .error-message {
            color: #dc3545;
            font-size: 0.75rem;
            margin-top: 2px;
        }

        .validation-summary-errors {
            background: #fff5f5;
            border: 1px solid #feb2b2;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 15px;
            font-size: 0.85rem;
        }

        .password-strength {
            height: 3px;
            margin-top: 3px;
            border-radius: 3px;
            transition: all 0.3s;
        }

        .strength-weak {
            background-color: #dc3545;
            width: 33%;
        }

        .strength-medium {
            background-color: #ffc107;
            width: 66%;
        }

        .strength-strong {
            background-color: #28a745;
            width: 100%;
        }

        .user-group-info {
            background-color: #f8f9fa;
            border-left: 3px solid #00AEEF;
            padding: 8px;
            margin-top: 5px;
            border-radius: 4px;
            font-size: 0.75rem;
        }

        .footer-note {
            text-align: center;
            margin-top: 15px;
            color: #8f9bb3;
            font-size: 0.75rem;
        }

        .row {
            margin-bottom: 8px;
        }

        .form-check-label {
            font-size: 0.85rem;
        }

        /* Custom scrollbar */
        .form-section::-webkit-scrollbar {
            width: 6px;
        }

        .form-section::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .form-section::-webkit-scrollbar-thumb {
            background: #00AEEF;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="signup-container">
        <div class="signup-row">
            <!-- Right side - Form Section -->
            <div class="form-section">
                <h2 class="brand-title">EasySacco</h2>
                <p class="brand-subtitle">Create Your Blockchain Account</p>

                <form asp-action="Signup" method="post" id="signupForm">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation-summary-errors">
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Account Information -->
                    <div class="form-section-title">
                        <i class="fas fa-user-circle me-2"></i>Account Information
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label asp-for="CompanyCode" class="form-label">Select Company</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-warehouse fa-sm"></i>
                                    </span>
                                    <select asp-for="CompanyCode" class="form-control" required>
                                        <option value="">-- Select a Company --</option>
                                        @if (ViewBag.Companies != null)
                                        {
                                            foreach (var company in ViewBag.Companies)
                                            {
                                                <option value="@company.CompanyCode">@company.DisplayText</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-2">
                                <label asp-for="UserGroup" class="form-label">User Group/Role</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-user-tag fa-sm"></i>
                                    </span>
                                    <select asp-for="UserGroup" class="form-control">
                                        <option value="">-- Select Role --</option>
                                        @foreach (var group in Model?.AvailableUserGroups ?? new List<string>())
                                        {
                                            <option value="@group">@group</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-2">
                                <label asp-for="UserName" class="form-label">Username</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-user fa-sm"></i>
                                    </span>
                                    <input asp-for="UserName" class="form-control" placeholder="Choose username" />
                                </div>
                                <span asp-validation-for="UserName" class="error-message"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label asp-for="Email" class="form-label">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-envelope fa-sm"></i>
                                    </span>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="your@email.com" />
                                </div>
                                <span asp-validation-for="Email" class="error-message"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label asp-for="Password" class="form-label">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-lock fa-sm"></i>
                                    </span>
                                    <input asp-for="Password" type="password" class="form-control" id="password" placeholder="Min. 6 characters" />
                                </div>
                                <div class="password-strength" id="passwordStrength"></div>
                                <span asp-validation-for="Password" class="error-message"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-lock fa-sm"></i>
                                    </span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="error-message"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label asp-for="Phone" class="form-label">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-phone fa-sm"></i>
                                    </span>
                                    <input asp-for="Phone" class="form-control" placeholder="Phone number" />
                                </div>
                                <span asp-validation-for="Phone" class="error-message"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label asp-for="Department" class="form-label">Department</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-building fa-sm"></i>
                                    </span>
                                    <input asp-for="Department" class="form-control" placeholder="Optional" />
                                </div>
                                <span asp-validation-for="Department" class="error-message"></span>
                            </div>
                        </div>
                        <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="SubCountyId" class="form-label">Sub-County</label>
                                <select asp-for="SubCountyId" class="form-control" id="SubCountyId">
                                    <option value="">-- Select Sub-County --</option>
                                    @if (ViewBag.SubCounties != null)
                                    {
                                        foreach (var subCounty in ViewBag.SubCounties)
                                        {
                                            <option value="@subCounty.Id">@subCounty.SubCountyName</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SubCountyId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="WardId" class="form-label">Ward</label>
                                <select asp-for="WardId" class="form-control" id="WardId">
                                    <option value="">-- Select Ward --</option>
                                </select>
                                <span asp-validation-for="WardId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
            </div>

                    <!-- Form Buttons -->
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Login" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to Login
                        </a>
                        <button type="submit" class="btn-signup">
                            <i class="fas fa-user-plus me-1"></i>Create Account
                        </button>
                    </div>

                    <div class="footer-note">
                        <i class="fas fa-lock me-1"></i>
                        Your data is protected by blockchain encryption
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery Validation -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function() {
            // Password strength indicator
            $('#password').on('input', function() {
                var password = $(this).val();
                var strengthBar = $('#passwordStrength');

                if (password.length === 0) {
                    strengthBar.removeClass().addClass('password-strength');
                    return;
                }

                var strength = 0;
                if (password.length >= 6) strength++;
                if (password.length >= 10) strength++;
                if (/[a-z]/.test(password)) strength++;
                if (/[A-Z]/.test(password)) strength++;
                if (/[0-9]/.test(password)) strength++;
                if (/[^a-zA-Z0-9]/.test(password)) strength++;

                strengthBar.removeClass().addClass('password-strength');
                if (strength <= 2) strengthBar.addClass('strength-weak');
                else if (strength <= 4) strengthBar.addClass('strength-medium');
                else strengthBar.addClass('strength-strong');
            });

            // Clear validation on input
            $('input, select').on('input change', function() {
                $(this).removeClass('is-invalid');
                $(this).nextAll('.error-message').first().text('');
            });

            // Auto-select user group based on member number
            $('#MemberNo').on('input', function() {
                var memberNo = $(this).val().trim();
                if (memberNo.length > 0 && $('#UserGroup').val() === '') {
                    $('#UserGroup').val('Member');
                }
            });
        });
    </script>
</body>
</html>