@using System.Security.Claims
@{
    ViewData["Title"] = "Switch Company";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentUserRole = User.FindFirstValue(ClaimTypes.Role);
    var currentUserGroup = User.FindFirstValue("UserGroup");
    var currentUserName = User.Identity?.Name;
    var currentUserLoginId = User.FindFirstValue("UserLoginId");
    var currentUserEmail = User.FindFirstValue("Email");

    var currentCompanyCode = User.FindFirstValue("CompanyCode");
    var currentCompanyName = User.FindFirstValue("CompanyName");
    var totalCompanies = ViewBag.TotalCompanies as int? ?? 0;
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="card-title mb-0">
                        <i class="bi bi-arrow-left-right me-2"></i>Switch Company
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row g-4">
                        <!-- ============================================================ -->
                        <!-- LEFT COLUMN (col-md-5): Current User Information              -->
                        <!-- ============================================================ -->
                        <div class="col-md-5">
                            <div class="card h-100 border-primary">
                                <div class="card-header bg-primary bg-opacity-10">
                                    <h6 class="mb-0">
                                        <i class="bi bi-person-circle me-2"></i>Current User Information
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <!-- Username -->
                                    <div class="mb-3">
                                        <label class="text-muted small d-block">Username</label>
                                        <p class="fw-bold mb-0">
                                            <i class="bi bi-person me-1 text-primary"></i>@currentUserName
                                        </p>
                                    </div>

                                    <!-- Login ID -->
                                    <div class="mb-3">
                                        <label class="text-muted small d-block">Login ID</label>
                                        <p class="fw-bold mb-0">
                                            <i class="bi bi-key me-1 text-primary"></i>@currentUserLoginId
                                        </p>
                                    </div>

                                    <!-- Email -->
                                    <div class="mb-3">
                                        <label class="text-muted small d-block">Email</label>
                                        <p class="fw-bold mb-0 text-break">
                                            <i class="bi bi-envelope me-1 text-primary"></i>@currentUserEmail
                                        </p>
                                    </div>

                                    <!-- Role -->
                                    <div class="mb-3">
                                        <label class="text-muted small d-block">Role</label>
                                        <p class="fw-bold mb-0">
                                            <span class="badge bg-info">@currentUserRole</span>
                                            @if (!string.IsNullOrEmpty(currentUserGroup) && currentUserGroup != currentUserRole)
                                            {
                                                <span class="badge bg-secondary ms-1">@currentUserGroup</span>
                                            }
                                        </p>
                                    </div>

                                    <!-- Department -->
                                    <div class="mb-3">
                                        <label class="text-muted small d-block">Department</label>
                                        <p class="fw-bold mb-0">
                                            <i class="bi bi-diagram-3 me-1 text-primary"></i>@(User.FindFirstValue("Department") ?? "N/A")
                                        </p>
                                    </div>

                                    <hr class="my-3" />

                                    <!-- Current Company (highlighted) -->
                                    <div class="p-3 rounded" style="background-color: rgba(13, 110, 253, 0.08); border-left: 4px solid #0d6efd;">
                                        <label class="text-muted small d-block mb-1">Current Company</label>
                                        <p class="fw-bold text-primary mb-1">
                                            <i class="bi bi-building me-1"></i>@currentCompanyName
                                        </p>
                                        <small class="text-muted">
                                            <i class="bi bi-hash"></i> @currentCompanyCode
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- RIGHT COLUMN (col-md-7): Select Company to Switch To          -->
                        <!-- ============================================================ -->
                        <div class="col-md-7">
                            <div class="card h-100">
                                <div class="card-header bg-success bg-opacity-10">
                                    <h6 class="mb-0">
                                        <i class="bi bi-building me-2"></i>Select Company to Switch To
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <form asp-action="SwitchCompany" method="post" id="switchCompanyForm">
                                        @Html.AntiForgeryToken()

                                        <!-- Info alert -->
                                        <div class="alert alert-info mb-3">
                                            <i class="bi bi-info-circle me-2"></i>
                                            <strong>@totalCompanies</strong> companies available. You can switch to any company.
                                        </div>

                                        <!-- Search input -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold small">
                                                <i class="bi bi-search me-1"></i>Search Companies
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-search"></i>
                                                </span>
                                                <input type="text" id="companySearchInput" class="form-control"
                                                       placeholder="Type company code or name to filter..."
                                                       onkeyup="filterCompanyList()" />
                                                <button type="button" class="btn btn-outline-secondary" onclick="clearSearch()">
                                                    <i class="bi bi-x-lg"></i> Clear
                                                </button>
                                            </div>
                                            <small class="text-muted">Type initials to filter companies (e.g., "KE" for Kenya, "SAC" for SACCO)</small>
                                        </div>

                                        <!-- Company dropdown -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold small">
                                                <i class="bi bi-list-ul me-1"></i>Available Companies
                                            </label>
                                            <select name="companyCode" id="companySelect" class="form-select" required size="8" style="height: auto;">
                                                <option value="">-- Select a company --</option>
                                                @if (ViewBag.Companies != null)
                                                {
                                                    foreach (var company in ViewBag.Companies)
                                                    {
                                                        var isCurrent = company.CompanyCode == currentCompanyCode;
                                                        var searchData = $"{company.CompanyCode} {company.CompanyName} {company.DisplayText}".ToLower();
                                                        if (isCurrent)
                                                        {
                                                            <option value="@company.CompanyCode" disabled selected class="bg-light" data-search="@searchData">
                                                                ✅ @company.DisplayText (Current)
                                                            </option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@company.CompanyCode" data-search="@searchData">
                                                                @company.DisplayText
                                                            </option>
                                                        }
                                                    }
                                                }
                                            </select>
                                            <small class="text-muted mt-2 d-block">
                                                <i class="bi bi-info-circle"></i> Click on a company to select it. Use the search box above to filter the list.
                                            </small>
                                        </div>

                                        <!-- Warning -->
                                        <div class="alert alert-warning mb-3">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                            <strong>Note:</strong> Switching companies will refresh your session. You will continue to have the same permissions but with the selected company context.
                                        </div>

                                        <!-- Action buttons -->
                                        <div class="d-flex justify-content-between gap-2 mt-3">
                                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                                <i class="bi bi-x-circle"></i> Cancel
                                            </a>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="bi bi-check-circle"></i> Switch Company
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-select {
        font-size: 1rem;
        padding: 0.5rem;
        border-radius: 8px;
    }

        .form-select option {
            padding: 8px 12px;
            border-bottom: 1px solid #f0f0f0;
        }

            .form-select option:hover {
                background-color: #e8f0fe;
            }

    .bg-primary.bg-opacity-10 {
        background-color: rgba(13, 110, 253, 0.1);
    }

    .bg-success.bg-opacity-10 {
        background-color: rgba(25, 135, 84, 0.1);
    }

    .border-primary {
        border-color: #0d6efd !important;
    }

    .card-header.bg-primary.bg-opacity-10 {
        border-bottom: 1px solid rgba(13, 110, 253, 0.2);
    }

    .card-header.bg-success.bg-opacity-10 {
        border-bottom: 1px solid rgba(25, 135, 84, 0.2);
    }

    #companySearchInput {
        border-radius: 6px;
    }

    .alert-info {
        background-color: #e7f3ff;
        border-color: #b6d4fe;
        color: #084298;
    }

    /* Make both cards equal height */
    .row.g-4 > [class*="col-"] {
        display: flex;
    }

        .row.g-4 > [class*="col-"] > .card {
            width: 100%;
        }
</style>

@section Scripts {
    <script>
        // Filter companies as user types
        function filterCompanyList() {
            var input = document.getElementById('companySearchInput');
            var filter = input.value.toLowerCase().trim();
            var select = document.getElementById('companySelect');
            var options = select.getElementsByTagName('option');

            var visibleCount = 0;
            var firstVisibleValue = null;

            for (var i = 0; i < options.length; i++) {
                var option = options[i];
                var text = option.textContent || option.innerText;
                var value = option.value;

                var searchData = option.getAttribute('data-search') || text.toLowerCase();

                if (value === "") {
                    option.style.display = '';
                    option.disabled = true;
                    continue;
                }

                if (filter === "" || searchData.indexOf(filter) > -1 || text.toLowerCase().indexOf(filter) > -1) {
                    option.style.display = '';
                    option.disabled = false;
                    visibleCount++;
                    if (firstVisibleValue === null) {
                        firstVisibleValue = value;
                    }
                } else {
                    option.style.display = 'none';
                    option.disabled = true;
                }
            }

            if (visibleCount === 1 && firstVisibleValue) {
                select.value = firstVisibleValue;
            }

            var noResultsMsg = document.getElementById('noResultsMsg');
            if (visibleCount === 0 && filter !== "") {
                if (!noResultsMsg) {
                    var msg = document.createElement('option');
                    msg.id = 'noResultsMsg';
                    msg.disabled = true;
                    msg.textContent = '-- No companies match "' + filter + '" --';
                    select.appendChild(msg);
                } else {
                    noResultsMsg.textContent = '-- No companies match "' + filter + '" --';
                    noResultsMsg.style.display = '';
                }
            } else if (noResultsMsg) {
                noResultsMsg.style.display = 'none';
            }
        }

        function clearSearch() {
            document.getElementById('companySearchInput').value = '';
            filterCompanyList();
            document.getElementById('companySearchInput').focus();
        }

        document.getElementById('switchCompanyForm').addEventListener('submit', function() {
            var btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i> Switching...';
            return true;
        });

        document.getElementById('companySearchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var select = document.getElementById('companySelect');
                var visibleOptions = Array.from(select.options).filter(opt => opt.style.display !== 'none' && opt.value !== "");
                if (visibleOptions.length === 1) {
                    select.value = visibleOptions[0].value;
                }
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            var searchTerm = '@ViewBag.SearchTerm';
            if (searchTerm) {
                document.getElementById('companySearchInput').value = searchTerm;
                filterCompanyList();
            }
        });
    </script>
}