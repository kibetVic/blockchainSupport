@using EasyBlockSupport.Models.DTOs
@model List<EasyBlockSupport.Models.ViewModels.LockedUserDTO>
@{
    ViewData["Title"] = "Locked Users";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4><i class="fas fa-lock"></i> Locked Users</h4>
            <p class="mb-0">Locked user accounts: @ViewBag.LockedCount</p>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by name, email, phone..." />
                        <button class="btn btn-primary" onclick="searchUsers()">
                            <i class="fas fa-search"></i> Search
                        </button>
                        <button class="btn btn-secondary" onclick="clearSearch()">
                            <i class="fas fa-times"></i> Clear
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <select id="statusFilter" class="form-select" onchange="filterByStatus()">
                        <option value="all">All Status</option>
                        <option value="Locked">Locked</option>
                        <option value="Active">Active</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Department</th>
                            <th>Role</th>
                            <th>Company</th>
                            <th>Failed Attempts</th>
                            <th>Locked Date</th>
                            <th>Lock Reason</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr data-id="@user.UserId" data-status="@user.Status">
                                    <td>
                                        <strong>@user.UserName</strong><br />
                                        <small class="text-muted">@user.UserLoginId</small>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@user.Phone</td>
                                    <td>@(user.Department ?? "-")</td>
                                    <td>
                                        <span class="badge bg-info">@user.UserGroup</span>
                                    </td>
                                    <td>
                                        <strong>@user.CompanyName</strong><br />
                                        <small class="text-muted">@user.CompanyCode</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">@user.FailedAttempts/5</span>
                                    </td>
                                    <td>@(user.LockedDate?.ToString("dd MMM yyyy, HH:mm") ?? "-")</td>
                                    <td>@user.LockReason</td>
                                    <td>
                                        @if (user.IsLocked)
                                        {
                                            <span class="badge bg-danger">Locked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@(user.Status ?? "Active")</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            @if (user.IsLocked)
                                            {
                                                <button class="btn btn-success btn-sm" onclick="unlockUser(@user.UserId, '@user.UserName')" title="Unlock">
                                                    <i class="fas fa-unlock-alt"></i> Unlock
                                                </button>
                                            }
                                            <a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <i class="fas fa-check-circle fa-3x text-success mb-3 d-block"></i>
                                    <h5>No locked users</h5>
                                    <p class="text-muted">All user accounts are active and unlocked.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="row mt-4">
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h4>@Model.Count</h4>
                                <p class="text-muted mb-0">Total Locked Users</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h4>@Model.Count(u => u.IsLocked)</h4>
                                <p class="text-muted mb-0">Currently Locked</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h4>@Model.Average(u => u.FailedAttempts).ToString("F0")</h4>
                                <p class="text-muted mb-0">Avg Failed Attempts</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; text-align:center; padding-top:20%;">
    <div class="spinner-border text-light" style="width:3rem; height:3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <div class="text-light mt-2">Processing...</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function searchUsers() {
            const searchTerm = $('#searchInput').val().toLowerCase();
            const statusFilter = $('#statusFilter').val();

            $('tbody tr').each(function() {
                const row = $(this);
                if (row.find('td').length === 0) return; // Skip "no data" row

                const text = row.text().toLowerCase();
                const status = row.data('status') || '';

                const matchesSearch = searchTerm === '' || text.includes(searchTerm);
                const matchesStatus = statusFilter === 'all' || status === statusFilter;

                row.toggle(matchesSearch && matchesStatus);
            });

            updateVisibleCount();
        }

        function clearSearch() {
            $('#searchInput').val('');
            $('#statusFilter').val('all');
            $('tbody tr').show();
            updateVisibleCount();
        }

        function filterByStatus() {
            searchUsers();
        }

        function updateVisibleCount() {
            const visibleCount = $('tbody tr:visible').not(':has(td[colspan])').length;
            if (visibleCount === 0 && $('tbody tr:visible').length === 0) {
                if ($('#noDataRow').length === 0) {
                    $('tbody').append(`
                        <tr id="noDataRow">
                            <td colspan="11" class="text-center py-5">
                                <i class="fas fa-search fa-3x text-muted mb-3 d-block"></i>
                                <h5>No matching users found</h5>
                                <p class="text-muted">Try adjusting your search or filter criteria.</p>
                            </td>
                        </tr>
                    `);
                }
            } else {
                $('#noDataRow').remove();
            }
        }

        function unlockUser(userId, userName) {
            Swal.fire({
                title: 'Unlock User',
                text: `Are you sure you want to unlock ${userName}?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, unlock',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    showLoading(true);
                    $.ajax({
                        url: '@Url.Action("UnlockUser", "Account")',
                        type: 'POST',
                        data: { userId: userId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            showLoading(false);
                            if (response.success) {
                                Swal.fire('Unlocked!', response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function(xhr) {
                            showLoading(false);
                            let errorMsg = 'An error occurred while unlocking the user.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errorMsg = xhr.responseJSON.message;
                            }
                            Swal.fire('Error', errorMsg, 'error');
                        }
                    });
                }
            });
        }

        function showLoading(show) {
            if (show) {
                $('#loadingOverlay').fadeIn(200);
            } else {
                $('#loadingOverlay').fadeOut(200);
            }
        }

        // Initialize on page load
        $(document).ready(function() {
            updateVisibleCount();
        });
    </script>
}