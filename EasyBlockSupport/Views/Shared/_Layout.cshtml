                function updateLoanWorkflowCounts() {
                    var companyCode = '@User.FindFirst("CompanyCode")?.Value';

                    $.ajax({
                        url: '@Url.Action("GetWorkflowCounts", "LoanMvc")',
                        type: 'GET',
                        data: { companyCode: companyCode },
                        success: function (response) {
                            if (response.success) {
                                $('#underAppraisalCount').text(response.data.underAppraisal || 0);
                                $('#pendingApprovalCount').text(response.data.pendingApproval || 0);
                                $('#pendingDisbursementCount').text(response.data.approvedPendingDisbursement || 0);
                            } else {
                                console.error('API returned success false:', response);
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('AJAX Error:', {
                                status: status,
                                error: error,
                                response: xhr.responseText
                            });
                        }
                    });
                }


                $(document).ready(function () {
                    updateLoanWorkflowCounts();
               
                    setInterval(updateLoanWorkflowCounts, 60000);
                });


        $(document).ready(function() {
            // ============================================
            // COMPLETELY DISABLE ALL DEFAULT SIDEBAR BEHAVIOR
            // ============================================

            // Method 1: Unbind all existing click handlers from nav-links
            $('.nav-link').off('click');
            $('.nav-item .nav-link').off('click');

            // Method 2: Handle parent menu items (with submenus) - TOGGLE ONLY
            $('.nav-sidebar .nav-item:has(.nav-treeview) > .nav-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();

                const $this = $(this);
                const $parentItem = $this.closest('.nav-item');
                const $treeview = $parentItem.find('.nav-treeview').first();
                const isOpen = $parentItem.hasClass('menu-open');

                // Close all other menus at the same level
                $parentItem.siblings('.nav-item.menu-open').each(function() {
                    $(this).removeClass('menu-open');
                    $(this).find('.nav-treeview').slideUp(200);
                });

                // Toggle current menu
                if (isOpen) {
                    $parentItem.removeClass('menu-open');
                    $treeview.slideUp(200);
                } else {
                    $parentItem.addClass('menu-open');
                    $treeview.slideDown(200);
                }

                return false;
            });

            // Handle nested treeview items
            $('.nav-treeview .nav-item:has(.nav-treeview) > .nav-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();

                const $this = $(this);
                const $parentItem = $this.closest('.nav-item');
                const $treeview = $parentItem.find('.nav-treeview').first();
                const isOpen = $parentItem.hasClass('menu-open');

                if (isOpen) {
                    $parentItem.removeClass('menu-open');
                    $treeview.slideUp(200);
                } else {
                    $parentItem.addClass('menu-open');
                    $treeview.slideDown(200);
                }

                return false;
            });

            // ============================================
            // CRITICAL FIX: Handle REAL navigation links (NO #)
            // ============================================
            $('.nav-treeview .nav-link').each(function() {
                var $link = $(this);
                var href = $link.attr('href');

                // Check if this is a real navigation link (not a menu toggle)
                if (href && href !== '#' && href !== 'javascript:void(0)' && !href.startsWith('#')) {
                    // Remove all existing handlers
                    $link.off('click');

                    // Add new handler that directly navigates
                    $link.on('click', function(e) {
                        e.stopPropagation();
                        // Direct navigation - NO preventDefault()
                        window.location.href = href;
                        return false;
                    });
                }
            });

            // Specifically target GLInquiry and all General Ledger links
            $('a[href*="GLInquiry"], a[href*="GlSetup"], a[href*="JournalPosting"], a[href*="Reports"]').each(function() {
                var $link = $(this);
                var href = $link.attr('href');

                if (href && href !== '#') {
                    $link.off('click');
                    $link.on('click', function(e) {
                        e.stopPropagation();
                        window.location.href = href;
                        return false;
                    });
                }
            });

            // ============================================
            // Highlight active menu item
            // ============================================
            function highlightActiveMenu() {
                const currentUrl = window.location.pathname.toLowerCase();

                $('.nav-link').removeClass('active');

                $('.nav-link').each(function() {
                    const $this = $(this);
                    const href = $this.attr('href');

                    if (href && href !== '#' && href !== '/' && href !== '') {
                        let cleanHref = href.toLowerCase().split('?')[0].split('#')[0];
                        let cleanCurrent = currentUrl.split('?')[0].split('#')[0];

                        if (cleanCurrent === cleanHref ||
                            (cleanCurrent !== '/' && cleanHref !== '/' && cleanCurrent.includes(cleanHref))) {

                            $this.addClass('active');

                            // Open parent menus
                            const $parentTreeview = $this.closest('.nav-treeview');
                            if ($parentTreeview.length) {
                                const $parentMenuItem = $parentTreeview.closest('.nav-item');
                                $parentMenuItem.addClass('menu-open');
                                $parentTreeview.show();

                                const $grandParentTreeview = $parentMenuItem.closest('.nav-treeview');
                                if ($grandParentTreeview.length) {
                                    $grandParentTreeview.closest('.nav-item').addClass('menu-open');
                                    $grandParentTreeview.show();
                                }
                            }
                        }
                    }
                });
            }

            highlightActiveMenu();

            // Handle window resize
            $(window).on('resize', function() {
                if ($(window).width() < 768) {
                    $('.app-sidebar').removeClass('sidebar-open');
                } else {
                    $('.app-sidebar').addClass('sidebar-open');
                }
            });
        });


        // ============================================================
        // WEATHER + LOCATION WIDGET
        // ============================================================
        (function () {
            const locEl      = document.getElementById('weatherLocationName');
            const iconEl     = document.getElementById('weatherIcon');
            const tempEl     = document.getElementById('weatherTemp');
            const condEl     = document.getElementById('weatherCondition');

            if (!locEl || !iconEl || !tempEl || !condEl) return;   // widget not on page

            // --------------------------------------------------------
            // Weather condition → Bootstrap Icon mapping
            // Open-Meteo returns a WMO weather code (0..99)
            // --------------------------------------------------------
            function iconForCode(code) {
                if (code === 0)                      return 'bi-sun';
                if (code === 1)                      return 'bi-brightness-high';
                if (code === 2)                      return 'bi-cloud-sun';
                if (code === 3)                      return 'bi-clouds';
                if (code >= 45 && code <= 48)        return 'bi-cloud-fog2';
                if (code >= 51 && code <= 57)        return 'bi-cloud-drizzle';
                if (code >= 61 && code <= 67)        return 'bi-cloud-rain';
                if (code >= 71 && code <= 77)        return 'bi-cloud-snow';
                if (code >= 80 && code <= 82)        return 'bi-cloud-rain-heavy';
                if (code >= 85 && code <= 86)        return 'bi-cloud-snow';
                if (code >= 95 && code <= 99)        return 'bi-cloud-lightning-rain';
                return 'bi-cloud';
            }

            function textForCode(code) {
                if (code === 0)                      return 'Clear';
                if (code === 1)                      return 'Mainly clear';
                if (code === 2)                      return 'Partly cloudy';
                if (code === 3)                      return 'Overcast';
                if (code >= 45 && code <= 48)        return 'Foggy';
                if (code >= 51 && code <= 57)        return 'Drizzle';
                if (code >= 61 && code <= 67)        return 'Rain';
                if (code >= 71 && code <= 77)        return 'Snow';
                if (code >= 80 && code <= 82)        return 'Rain showers';
                if (code >= 85 && code <= 86)        return 'Snow showers';
                if (code >= 95 && code <= 99)        return 'Thunderstorm';
                return '—';
            }

            // --------------------------------------------------------
            // Fail-safe state
            // --------------------------------------------------------
            function setUnavailable(reason) {
                locEl.innerHTML     = '<i class="bi bi-geo text-muted me-1"></i><span class="text-muted small">Location unavailable</span>';
                tempEl.textContent  = '--°';
                condEl.textContent  = reason || '—';
                iconEl.className    = 'bi bi-cloud text-muted me-1 fs-5';
                console.warn('Weather widget:', reason);
            }

            // --------------------------------------------------------
            // Fetch weather from Open-Meteo (no key)
            // --------------------------------------------------------
            async function loadWeather(lat, lon) {
                try {
                    const url =
                        `https://api.open-meteo.com/v1/forecast` +
                        `?latitude=${lat}&longitude=${lon}` +
                        `&current=temperature_2m,weather_code` +
                        `&timezone=auto`;

                    const resp = await fetch(url, { cache: 'no-store' });
                    if (!resp.ok) throw new Error('HTTP ' + resp.status);

                    const data = await resp.json();
                    const current = data.current || {};
                    const t   = current.temperature_2m;
                    const code = current.weather_code;

                    if (t === undefined || code === undefined)
                        throw new Error('Malformed weather payload');

                    tempEl.textContent = `${Math.round(t)}°C`;
                    condEl.textContent = textForCode(code);
                    iconEl.className   = `bi ${iconForCode(code)} text-warning me-1 fs-5`;
                } catch (err) {
                    setUnavailable('Weather unavailable');
                }
            }

            // --------------------------------------------------------
            // Reverse geocode coordinates → place name
            // BigDataCloud — free, no key required
            // --------------------------------------------------------
            async function loadLocationName(lat, lon) {
                try {
                    const url =
                        `https://api.bigdatacloud.net/data/reverse-geocode-client` +
                        `?latitude=${lat}&longitude=${lon}&localityLanguage=en`;

                    const resp = await fetch(url, { cache: 'no-store' });
                    if (!resp.ok) throw new Error('HTTP ' + resp.status);

                    const data = await resp.json();
                    const city    = data.city || data.locality || data.principalSubdivision || '';
                    const country = data.countryName || '';

                    let label = '';
                    if (city && country)  label = `${city}, ${country}`;
                    else if (city)        label = city;
                    else if (country)     label = country;
                    else                  label = `${lat.toFixed(2)}, ${lon.toFixed(2)}`;  // fallback

                    locEl.innerHTML =
                        `<i class="bi bi-geo-alt-fill text-primary me-1"></i>` +
                        `<span class="fw-semibold small">${escapeHtml(label)}</span>`;
                } catch (err) {
                    // Keep whatever the browser told us from coords
                    locEl.innerHTML =
                        `<i class="bi bi-geo-alt-fill text-primary me-1"></i>` +
                        `<span class="fw-semibold small">${lat.toFixed(2)}, ${lon.toFixed(2)}</span>`;
                }
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = String(text ?? '');
                return div.innerHTML;
            }

            // --------------------------------------------------------
            // Boot
            // --------------------------------------------------------
            function init(lat, lon) {
                loadLocationName(lat, lon);
                loadWeather(lat, lon);
                // Refresh weather every 15 minutes
                setInterval(() => loadWeather(lat, lon), 15 * 60 * 1000);
            }

            if (!navigator.geolocation) {
                setUnavailable('Geolocation not supported');
                return;
            }

            navigator.geolocation.getCurrentPosition(
                (pos) => init(pos.coords.latitude, pos.coords.longitude),
                (err) => {
                    // Permission denied, timeout, unavailable
                    let reason = 'Location permission denied';
                    if (err.code === err.POSITION_UNAVAILABLE) reason = 'Location unavailable';
                    if (err.code === err.TIMEOUT)              reason = 'Location timeout';
                    setUnavailable(reason);
                },
                { enableHighAccuracy: false, timeout: 8000, maximumAge: 5 * 60 * 1000 }
            );
        })();
        

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>