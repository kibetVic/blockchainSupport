@model EasyBlockSupport.ViewModels.BlockDetailsViewModel

@{
    ViewData["Title"] = "Block Details";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-cube"></i> Block </h4>
                   @*  <span class="badge @(Model.IsValid ? "bg-success" : "bg-danger")">
                        @(Model.IsValid ? "Valid" : "Invalid")
                    </span> *@
                </div>
                <div class="card-body">
                    <!-- Block Information -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <table class="table table-bordered">
                                <tr>
                                    <th style="width: 20%">Block Hash:</th>
                                    <td><code>@Model.Block.BlockHash</code></td>
                                </tr>
                                <tr>
                                    <th>Previous Hash:</th>
                                    <td>
                                        <code>@Model.Block.PreviousHash</code>
                                        @if (Model.Block.PreviousHash != "0")
                                        {
                                            <a href="@Url.Action("BlockDetails", new { blockHash = Model.Block.PreviousHash })"
                                               class="btn btn-sm btn-outline-primary ms-2">
                                                <i class="fas fa-link"></i> View Previous
                                            </a>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Merkle Root:</th>
                                    <td><code>@Model.Block.MerkleRoot</code></td>
                                </tr>
                                <tr>
                                    <th>Timestamp:</th>
                                    <td>@Model.Block.Timestamp.ToString("dd MMMM yyyy HH:mm:ss")</td>
                                </tr>
                                <tr>
                                    <th>Nonce:</th>
                                    <td>@Model.Block.Nonce</td>
                                </tr>
                                <tr>
                                    <th>Status:</th>
                                    <td>
                                        @if (Model.Block.Confirmed)
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Transactions:</th>
                                    <td>@Model.TransactionCount</td>
                                </tr>
                                <tr>
                                    <th>Total Amount:</th>
                                    <td><strong>KES @Model.TotalAmount.ToString("N2")</strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Transactions in this Block -->
                    <h5 class="mb-3"><i class="fas fa-list"></i> Transactions in this Block</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Transaction ID</th>
                                    <th>Type</th>
                                    <th>Member</th>
                                    <th>Amount</th>
                                    <th>Timestamp</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in Model.Transactions)
                                {
                                    <tr>
                                        <td><code>@tx.TransactionId.Substring(0, 8)...</code></td>
                                        <td>
                                            <span class="badge bg-info">@tx.TransactionType</span>
                                        </td>
                                        <td>@tx.MemberNo</td>
                                        <td>KES @tx.Amount.ToString("N2")</td>
                                        <td>@tx.Timestamp.ToString("HH:mm:ss")</td>
                                        <td>
                                            @if (tx.Status == "CONFIRMED")
                                            {
                                                <span class="badge bg-success">Confirmed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action("TransactionDetails", new { transactionId = tx.TransactionId })"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-search"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Verification Actions -->
                    <div class="row mt-4">
                        <div class="col-md-12">
                            @* <a href="@Url.Action("VerifyBlock", new { blockHash = Model.Block.BlockHash })"
                               class="btn btn-success" target="_blank">
                                <i class="fas fa-shield-alt"></i> Verify Block
                            </a> *@
                            <a href="@Url.Action("Explorer")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Explorer
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>