@model IEnumerable<EasyBlockSupport.Models.BlockchainTransaction>

@{
    ViewData["Title"] = "Recent Transactions";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-clock"></i> Recent Transactions</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="transactionsTable">
                            <thead>
                                <tr>
                                    <th>Transaction ID</th>
                                    <th>Type</th>
                                    <th>Member No</th>
                                    <th>Amount</th>
                                    <th>Timestamp</th>
                                    <th>Status</th>
                                    <th>Block Hash</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in Model)
                                {
                                    <tr>
                                        <td><code>@tx.TransactionId.Substring(0, Math.Min(8, tx.TransactionId?.Length ?? 0))...</code></td>
                                        <td>
                                            <span class="badge bg-info">@tx.TransactionType</span>
                                        </td>
                                        <td>@tx.MemberNo</td>
                                        <td>KES @tx.Amount.ToString("N2")</td>
                                        <td>@tx.Timestamp.ToString("dd MMM HH:mm:ss")</td>
                                        <td>
                                            @if (tx.Status == "CONFIRMED")
                                            {
                                                <span class="badge bg-success">Confirmed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(tx.BlockHash))
                                            {
                                                <code>@tx.BlockHash.Substring(0, Math.Min(8, tx.BlockHash.Length))...</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="TransactionDetails" asp-route-transactionId="@tx.TransactionId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-search"></i> View
                                            </a>
                                            <a asp-action="Verify" asp-route-transactionId="@tx.TransactionId"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-shield-alt"></i> Verify
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-exchange-alt fa-3x text-muted mb-3"></i>
                            <h5>No transactions found</h5>
                            <p>There are no recent transactions to display.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#transactionsTable').DataTable({
                pageLength: 25,
                order: [[4, 'desc']],
                language: {
                    emptyTable: "No transactions found"
                }
            });

            // Auto-refresh every 30 seconds
            setTimeout(function() {
                location.reload();
            }, 30000);
        });
    </script>
}