@model EasyBlockSupport.ViewModels.ReferenceVerificationViewModel

@{
    ViewData["Title"] = "Verify by Reference";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-shield-alt"></i>
                        Verification Results for @Model.ReferenceType: @Model.ReferenceId
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert @(Model.AllVerified ? "alert-success" : "alert-warning")">
                        <h5 class="alert-heading">
                            <i class="fas @(Model.AllVerified ? "fa-check-circle" : "fa-exclamation-triangle")"></i>
                            @(Model.AllVerified ? "All transactions verified successfully" : "Some transactions failed verification")
                        </h5>
                        <p>Total Transactions: @Model.TotalTransactions | Total Amount: KES @Model.TotalAmount.ToString("N2")</p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="transactionsTable">
                            <thead>
                                <tr>
                                    <th>Transaction ID</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Timestamp</th>
                                    <th>Status</th>
                                    <th>Block Hash</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in Model.Transactions)
                                {
                                    <tr>
                                        <td><code>@tx.TransactionId</code></td>
                                        <td><span class="badge bg-info">@tx.TransactionType</span></td>
                                        <td>KES @tx.Amount.ToString("N2")</td>
                                        <td>@tx.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            @if (tx.Status == "CONFIRMED")
                                            {
                                                <span class="badge bg-success">Confirmed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(tx.BlockHash))
                                            {
                                                <code>@tx.BlockHash.Substring(0, 8)...</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Verify", new { transactionId = tx.TransactionId })"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-shield-alt"></i> Verify
                                            </a>
                                            <a href="@Url.Action("TransactionDetails", new { transactionId = tx.TransactionId })"
                                               class="btn btn-sm btn-outline-info">
                                                <i class="fas fa-info-circle"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <a href="@Url.Action("Verify")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Verify
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#transactionsTable').DataTable({
                pageLength: 25,
                order: [[3, 'desc']]
            });
        });
    </script>
}