@model EasyBlockSupport.ViewModels.TransactionDetailsViewModel

@{
    ViewData["Title"] = "Transaction Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .status-confirmed {
            background: #10b981;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pending {
            background: #f59e0b;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-failed {
            background: #ef4444;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .verified-badge {
            background: #10b981;
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
        }

        .not-verified-badge {
            background: #ef4444;
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
        }

        .info-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .info-label {
            font-weight: 600;
            color: #6c757d;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .info-value {
            font-size: 14px;
            word-break: break-all;
        }

        .json-viewer {
            background: #1e1e1e;
            color: #d4d4d4;
            padding: 15px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 12px;
            overflow-x: auto;
            max-height: 400px;
        }
    </style>
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <!-- Header Card -->
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-exchange-alt"></i> Transaction Details
                    </h4>
                    <span class="@(Model.VerificationStatus ? "verified-badge" : "not-verified-badge")">
                        <i class="fas @(Model.VerificationStatus ? "fa-check-circle" : "fa-exclamation-triangle") me-1"></i>
                        @(Model.VerificationStatus ? "Verified" : "Not Verified")
                    </span>
                </div>
                <div class="card-body">
                    <!-- Transaction Information -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-card">
                                <div class="info-label">Transaction ID</div>
                                <div class="info-value">
                                    <code>@Model.Transaction.TransactionId</code>
                                    <button class="btn btn-sm btn-outline-secondary ms-2" onclick="copyToClipboard('@Model.Transaction.TransactionId')">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <div class="info-label">Status</div>
                                <div class="info-value">
                                    @if (Model.Transaction.Status == "CONFIRMED")
                                    {
                                        <span class="status-confirmed">
                                            <i class="fas fa-check-circle me-1"></i> Confirmed
                                        </span>
                                    }
                                    else if (Model.Transaction.Status == "PENDING")
                                    {
                                        <span class="status-pending">
                                            <i class="fas fa-clock me-1"></i> Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-failed">
                                            <i class="fas fa-times-circle me-1"></i> Failed
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="info-card">
                                <div class="info-label">Transaction Type</div>
                                <div class="info-value">
                                    <span class="badge bg-info">@Model.Transaction.TransactionType</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-card">
                                <div class="info-label">Member Number</div>
                                <div class="info-value">
                                    <strong>@(Model.Transaction.MemberNo ?? "N/A")</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-card">
                                <div class="info-label">Amount</div>
                                <div class="info-value">
                                    <strong class="text-success">KES @Model.Transaction.Amount.ToString("N2")</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="info-card">
                                <div class="info-label">Timestamp</div>
                                <div class="info-value">
                                    <i class="far fa-calendar-alt me-1"></i>
                                    @Model.Transaction.Timestamp.ToString("dd MMMM yyyy HH:mm:ss")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-card">
                                <div class="info-label">Company Code</div>
                                <div class="info-value">
                                    @(Model.Transaction.CompanyCode ?? "N/A")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-card">
                                <div class="info-label">Reference ID</div>
                                <div class="info-value">
                                    <code>@(Model.Transaction.OffChainReferenceId ?? "N/A")</code>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Block Information -->
                    @if (Model.Block != null)
                    {
                        <div class="info-card">
                            <div class="info-label">Block Information</div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div><strong>Block Hash:</strong></div>
                                    <code>@Model.Block.BlockHash</code>
                                </div>
                                <div class="col-md-6 text-end">
                                    <a href="@Url.Action("BlockDetails", new { blockHash = Model.Block.BlockHash })" class="btn btn-sm btn-primary">
                                        <i class="fas fa-cube"></i> View Block
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="info-card">
                            <div class="info-label">Block Information</div>
                            <div class="alert alert-warning mb-0">
                                <i class="fas fa-hourglass-half me-2"></i>
                                This transaction is pending and not yet included in a block.
                            </div>
                        </div>
                    }

                    <!-- Data Hash -->
                    <div class="info-card">
                        <div class="info-label">Data Hash (SHA256)</div>
                        <div class="info-value">
                            <code>@Model.Transaction.DataHash</code>
                        </div>
                    </div>

                    <!-- Payload JSON -->
                    @if (Model.Payload != null)
                    {
                        <div class="info-card">
                            <div class="info-label d-flex justify-content-between align-items-center">
                                <span>Transaction Payload</span>
                                <button class="btn btn-sm btn-outline-secondary" onclick="toggleJsonView()">
                                    <i class="fas fa-code"></i> Expand/Collapse
                                </button>
                            </div>
                            <div id="jsonViewer" style="display: none;">
                                <div class="json-viewer mt-2">
                                    <pre id="jsonContent" style="margin: 0; color: #d4d4d4;">@System.Text.Json.JsonSerializer.Serialize(Model.Payload, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
                                </div>
                            </div>
                            <div id="jsonSummary" class="alert alert-secondary mt-2">
                                <i class="fas fa-database me-2"></i>
                                Transaction payload contains structured data. Click expand to view.
                            </div>
                        </div>
                    }

                    <!-- Related Data -->
                    @if (Model.RelatedData != null)
                    {
                        <div class="info-card">
                            <div class="info-label">Related Data</div>
                            <div class="json-viewer" style="background: #f8f9fa; color: #333;">
                                <pre style="margin: 0;">@System.Text.Json.JsonSerializer.Serialize(Model.RelatedData, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
                            </div>
                        </div>
                    }

                    <!-- Verification Details -->
                    <h5 class="mt-4 mb-3">
                        <i class="fas fa-shield-alt"></i> Verification Details
                    </h5>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="info-card text-center">
                                <div class="info-label">In Block</div>
                                <div class="info-value">
                                    @if (!string.IsNullOrEmpty(Model.Transaction.BlockHash))
                                    {
                                        <i class="fas fa-check-circle text-success fa-2x"></i>
                                        <div>Yes</div>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-danger fa-2x"></i>
                                        <div>No</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-card text-center">
                                <div class="info-label">Block Confirmed</div>
                                <div class="info-value">
                                    @if (Model.Transaction.Status == "CONFIRMED")
                                    {
                                        <i class="fas fa-check-circle text-success fa-2x"></i>
                                        <div>Yes</div>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-danger fa-2x"></i>
                                        <div>No</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-card text-center">
                                <div class="info-label">Data Integrity</div>
                                <div class="info-value">
                                    <i class="fas fa-check-circle text-success fa-2x"></i>
                                    <div>Valid</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-card text-center">
                                <div class="info-label">Blockchain Verified</div>
                                <div class="info-value">
                                    @if (Model.VerificationStatus)
                                    {
                                        <i class="fas fa-check-circle text-success fa-2x"></i>
                                        <div>Verified</div>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-danger fa-2x"></i>
                                        <div>Not Verified</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <a href="@Url.Action("Verify", new { transactionId = Model.Transaction.TransactionId })"
                               class="btn btn-success" target="_blank">
                                <i class="fas fa-shield-alt"></i> Full Verification
                            </a>
                            <a href="@Url.Action("Explorer")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Explorer
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                alert('Copied to clipboard!');
            });
        }

        function toggleJsonView() {
            var jsonViewer = document.getElementById('jsonViewer');
            var jsonSummary = document.getElementById('jsonSummary');

            if (jsonViewer.style.display === 'none') {
                jsonViewer.style.display = 'block';
                jsonSummary.style.display = 'none';
            } else {
                jsonViewer.style.display = 'none';
                jsonSummary.style.display = 'block';
            }
        }
    </script>
}