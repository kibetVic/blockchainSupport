@model EasyBlockSupport.ViewModels.BlockchainExplorerViewModel

@{
    ViewData["Title"] = "Blockchain Explorer";
}

<div class="container-fluid px-2 px-md-3">
    <!-- Blockchain Status Cards - Stack on mobile -->
    <div class="row mb-4 g-2 g-md-3">
        <div class="col-6 col-md-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body p-2 p-md-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0 mb-md-1 small">Total Blocks</h6>
                            <h3 class="mb-0 fs-2 fs-md-1">@Model.Status.TotalBlocks</h3>
                        </div>
                        <i class="fas fa-cubes fa-2x fa-md-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body p-2 p-md-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0 mb-md-1 small">Total Transactions</h6>
                            <h3 class="mb-0 fs-2 fs-md-1">@Model.Status.TotalTransactions</h3>
                        </div>
                        <i class="fas fa-exchange-alt fa-2x fa-md-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-warning text-white h-100">
                <div class="card-body p-2 p-md-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0 mb-md-1 small">Pending</h6>
                            <h3 class="mb-0 fs-2 fs-md-1">@Model.Status.PendingTransactions</h3>
                        </div>
                        <i class="fas fa-clock fa-2x fa-md-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card @(Model.Status.IsValid ? "bg-success" : "bg-danger") text-white h-100">
                <div class="card-body p-2 p-md-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0 mb-md-1 small">Chain Status</h6>
                            <h5 class="mb-0 fs-6 fs-md-5">
                                @if (Model.Status.IsValid)
                                {
                                    <span><i class="fas fa-check-circle"></i> Valid</span>
                                }
                                else
                                {
                                    <span><i class="fas fa-exclamation-triangle"></i> Invalid</span>
                                }
                            </h5>
                        </div>
                        <i class="fas fa-shield-alt fa-2x fa-md-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Latest Block Info - Responsive -->
    @if (Model.Status.LatestBlockHash != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-info text-white py-2 py-md-3">
                        <h5 class="mb-0 fs-6 fs-md-5"><i class="fas fa-cube"></i> Latest Block</h5>
                    </div>
                    <div class="card-body p-2 p-md-3">
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-md-8">
                                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2">
                                    <code class="bg-light p-2 rounded flex-grow-1 small text-break">@Model.Status.LatestBlockHash</code>
                                    <a href="@Url.Action("BlockDetails", new { blockHash = Model.Status.LatestBlockHash })"
                                       class="btn btn-sm btn-info text-nowrap">
                                        <i class="fas fa-search"></i> View
                                    </a>
                                </div>
                            </div>
                            <div class="col-12 col-md-4 text-md-end">
                                <small class="text-muted">
                                    <i class="fas fa-clock"></i>
                                    @Model.Status.LatestBlockTimestamp?.ToString("dd MMM yyyy HH:mm:ss")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-2 g-md-3">
        <!-- Blocks List - Full width on mobile, then 2/3 on tablet/desktop -->
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header py-2 py-md-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fs-6 fs-md-5"><i class="fas fa-cubes"></i> Blocks</h5>
                    <span class="badge bg-secondary">@Model.TotalBlocks total</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @{
                            int blockNumber = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                            var orderedBlocks = Model.Blocks.OrderBy(b => b.Timestamp).ToList();
                        }
                        @foreach (var block in orderedBlocks)
                        {
                            <div class="list-group-item p-2 p-md-3">
                                <!-- Mobile: Stack vertically, Desktop: Row layout -->
                                <div class="d-block d-md-none">
                                    <!-- Mobile Layout -->
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="badge bg-secondary">#@blockNumber</span>
                                            @if (blockNumber == 1)
                                            {
                                                <span class="badge bg-success ms-1">GENESIS</span>
                                            }
                                        </div>
                                        <small class="text-muted">@block.Timestamp.ToString("HH:mm:ss")</small>
                                    </div>
                                    <div class="mb-2">
                                        <code class="text-primary small text-break">@block.BlockHash</code>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="badge bg-info">@(block.Transactions?.Count ?? 0) txns</span>
                                            <span class="badge bg-success ms-1">KES @(block.Transactions?.Sum(t => t.Amount).ToString("N0") ?? "0")</span>
                                        </div>
                                        <a href="@Url.Action("BlockDetails", new { blockHash = block.BlockHash })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-search"></i> View
                                        </a>
                                    </div>
                                    <div>
                                        <small class="text-muted">
                                            <i class="fas fa-link"></i> Previous:
                                            <code class="text-muted small text-break">@block.PreviousHash</code>
                                        </small>
                                    </div>
                                </div>

                                <!-- Desktop Layout (md and above) -->
                                <div class="d-none d-md-block">
                                    <div class="row align-items-center">
                                        <div class="col-md-1 text-center">
                                            <span class="badge bg-secondary">#@blockNumber</span>
                                            @if (blockNumber == 1)
                                            {
                                                <span class="badge bg-success ms-1" style="font-size: 8px;">GENESIS</span>
                                            }
                                        </div>
                                        <div class="col-md-4">
                                            <code class="text-primary text-break">@block.BlockHash</code>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="badge bg-info">@(block.Transactions?.Count ?? 0) txns</span>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="badge bg-success">KES @(block.Transactions?.Sum(t => t.Amount).ToString("N0") ?? "0")</span>
                                        </div>
                                        <div class="col-md-1">
                                            <small>@block.Timestamp.ToString("HH:mm:ss")</small>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <a href="@Url.Action("BlockDetails", new { blockHash = block.BlockHash })"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-search"></i> View
                                            </a>
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-12">
                                            <small class="text-muted">
                                                <i class="fas fa-link"></i> Previous:
                                                <code class="text-muted text-break">@block.PreviousHash</code>
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            blockNumber++;
                        }
                    </div>
                </div>
                <div class="card-footer py-2 py-md-3">
                    <!-- Responsive Pagination -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0 flex-wrap">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Explorer", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize })">
                                    <i class="fas fa-chevron-left"></i>
                                    <span class="d-none d-sm-inline"> Prev</span>
                                </a>
                            </li>

                            @if (Model.TotalPages <= 7)
                            {
                                for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "") d-none d-sm-block">
                                        <a class="page-link" href="@Url.Action("Explorer", new { page = i, pageSize = Model.PageSize })">@i</a>
                                    </li>
                                }
                            }
                            else
                            {
                                // Show first page
                                <li class="page-item @(1 == Model.CurrentPage ? "active" : "") d-none d-sm-block">
                                    <a class="page-link" href="@Url.Action("Explorer", new { page = 1, pageSize = Model.PageSize })">1</a>
                                </li>

                                @if (Model.CurrentPage > 3)
                                {
                                    <li class="page-item disabled d-none d-sm-block"><span class="page-link">...</span></li>
                                }

                                // Show pages around current
                                for (int i = Math.Max(2, Model.CurrentPage - 1); i <= Math.Min(Model.TotalPages - 1, Model.CurrentPage + 1); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "") d-none d-sm-block">
                                        <a class="page-link" href="@Url.Action("Explorer", new { page = i, pageSize = Model.PageSize })">@i</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages - 2)
                                {
                                    <li class="page-item disabled d-none d-sm-block"><span class="page-link">...</span></li>
                                }

                                // Show last page
                                <li class="page-item @(Model.TotalPages == Model.CurrentPage ? "active" : "") d-none d-sm-block">
                                    <a class="page-link" href="@Url.Action("Explorer", new { page = Model.TotalPages, pageSize = Model.PageSize })">@Model.TotalPages</a>
                                </li>
                            }

                            <!-- Mobile simplified pagination - shows current/total -->
                            <li class="page-item active d-sm-none">
                                <span class="page-link">@Model.CurrentPage / @Model.TotalPages</span>
                            </li>

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Explorer", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize })">
                                    <span class="d-none d-sm-inline">Next </span>
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-center mt-2">
                        <small class="text-muted">
                            Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to 
                            @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalBlocks)) 
                            of @Model.TotalBlocks blocks
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Transactions - Full width on mobile, then 1/3 on desktop -->
        <div class="col-12 col-lg-4">
            <div class="card">
                <div class="card-header py-2 py-md-3">
                    <h5 class="mb-0 fs-6 fs-md-5"><i class="fas fa-history"></i> Recent Transactions</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var tx in Model.RecentTransactions.Take(10))
                        {
                            <div class="list-group-item p-2 p-md-3">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                    <div>
                                        <span class="badge @(tx.Status == "CONFIRMED" ? "bg-success" : "bg-warning")">
                                            @tx.TransactionType
                                        </span>
                                    </div>
                                    <small class="text-muted">@tx.Timestamp.ToString("HH:mm:ss")</small>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted d-block mb-1">
                                        <i class="fas fa-user"></i> Member: @tx.MemberNo
                                    </small>
                                    <small class="text-muted d-block mb-2">
                                        <i class="fas fa-money-bill"></i> Amount: KES @tx.Amount.ToString("N2")
                                    </small>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <code class="small text-truncate flex-grow-1 me-2">@tx.TransactionId.Substring(0, Math.Min(16, tx.TransactionId?.Length ?? 0))...</code>
                                        <a href="@Url.Action("TransactionDetails", new { transactionId = tx.TransactionId })"
                                           class="btn btn-sm btn-link p-0 text-nowrap">
                                            View <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (!Model.RecentTransactions.Any())
                        {
                            <div class="list-group-item text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                No transactions found
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-refresh every 30 seconds (optional - can be disabled on mobile to save battery)
            var refreshInterval = 30000;

            // Check if mobile device - use longer interval or disable
            function isMobileDevice() {
                return window.innerWidth <= 768;
            }

            if (!isMobileDevice()) {
                setTimeout(function() {
                    location.reload();
                }, refreshInterval);
            } else {
                // Longer interval on mobile (60 seconds)
                setTimeout(function() {
                    location.reload();
                }, 60000);
            }

            // Adjust on resize
            $(window).on('resize', function() {
                // Optional: handle resize events
            });
        });
    </script>
}

<style>
    /* Additional responsive styles */
    @@media (max-width: 576px) {
        .card-title {
            font-size: 0.75rem;
        }

        .badge {
            font-size: 0.7rem;
        }

        .btn-sm {
            font-size: 0.7rem;
        }

        code {
            font-size: 0.7rem;
        }

        .fs-2 {
            font-size: 1.5rem !important;
        }
    }

    /* Ensure text breaks properly on small screens */
    .text-break {
        word-break: break-all;
        overflow-wrap: break-word;
    }

    /* Better touch targets on mobile */
    @@media (max-width: 768px) {
        .btn,
        .page-link,
        .list-group-item {
            min-height: 44px;
        }

        .btn-sm {
            min-height: 36px;
        }

        .page-link {
            padding: 0.5rem 0.75rem;
        }
    }

    /* Smooth transitions */
    .list-group-item {
        transition: background-color 0.2s ease;
    }

        .list-group-item:active {
            background-color: rgba(0,0,0,0.05);
        }
</style>