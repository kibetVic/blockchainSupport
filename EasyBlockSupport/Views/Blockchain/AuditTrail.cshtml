@model EasyBlockSupport.ViewModels.AuditTrailViewModel

@{
    ViewData["Title"] = "Audit Trail";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-history"></i> Blockchain Audit Trail for Member @Model.MemberNo</h4>
                </div>
                <div class="card-body">
                    <!-- Chain Status -->
                    <div class="alert @(Model.ChainValid ? "alert-success" : "alert-danger") mb-4">
                        <h5 class="alert-heading">
                            <i class="fas @(Model.ChainValid ? "fa-link" : "fa-unlink")"></i>
                            @(Model.ChainValid ? "Blockchain Chain is Valid" : "Blockchain Chain Integrity Check Failed")
                        </h5>
                        <p>Total Transactions: @Model.TotalCount | Total Amount: KES @Model.TotalAmount.ToString("N2")</p>
                    </div>

                    <!-- Timeline Visualization -->
                    <div class="timeline mb-4">
                        <h5>Transaction Timeline</h5>
                        <div class="progress" style="height: 30px; position: relative; background-color: #e9ecef;">
                            @if (Model.Transactions.Any())
                            {
                                var firstDate = Model.FirstTransaction?.Timestamp ?? DateTime.Now;
                                var lastDate = Model.LastTransaction?.Timestamp ?? DateTime.Now;
                                var timespan = (lastDate - firstDate).TotalSeconds;

                                if (timespan > 0)
                                {
                                    foreach (var tx in Model.Transactions)
                                    {
                                        var position = ((tx.Timestamp - firstDate).TotalSeconds / timespan * 100);
                                        <div class="progress-bar bg-info"
                                             style="width: 4px; left: @Math.Max(0, Math.Min(100, position))%; position: absolute; height: 30px; background-color: #17a2b8;"
                                             title="@tx.TransactionType - @tx.Timestamp.ToString("HH:mm:ss")">
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>

                    <!-- Transactions List -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped" id="auditTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Transaction ID</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Timestamp</th>
                                    <th>Status</th>
                                    <th>Verified</th>
                                    <th>Block Hash</th>
                                    <th>Data Hash</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Transactions.Count; i++)
                                {
                                    var tx = Model.Transactions[i];
                                    var isValid = Model.VerificationStatuses.ContainsKey(tx.TransactionId) &&
                                    Model.VerificationStatuses[tx.TransactionId];

                                    <tr class="@(isValid ? "" : "table-warning")">
                                        <td>@(i + 1)</td>
                                        <td><code>@tx.TransactionId.Substring(0, Math.Min(8, tx.TransactionId.Length))...</code></td>
                                        <td>
                                            <span class="badge bg-info">@tx.TransactionType</span>
                                        </td>
                                        <td>KES @tx.Amount.ToString("N2")</td>
                                        <td>@tx.Timestamp.ToString("dd MMM yyyy HH:mm:ss")</td>
                                        <td>
                                            @if (tx.Status == "CONFIRMED")
                                            {
                                                <span class="badge bg-success">Confirmed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            @if (isValid)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check-circle"></i> Valid
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times-circle"></i> Invalid
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(tx.BlockHash))
                                            {
                                                <code>@tx.BlockHash.Substring(0, Math.Min(8, tx.BlockHash.Length))...</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td><code>@(tx.DataHash?.Substring(0, Math.Min(8, tx.DataHash?.Length ?? 0)) ?? "...")</code></td>
                                        <td>
                                            <a href="@Url.Action("TransactionDetails", new { transactionId = tx.TransactionId })"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-search"></i> View
                                            </a>
                                            <a href="@Url.Action("Verify", new { transactionId = tx.TransactionId })"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-shield-alt"></i> Verify
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Chain Visualization -->
                    @if (Model.Transactions.Any(t => !string.IsNullOrEmpty(t.BlockHash)))
                    {
                        <div class="mt-4">
                            <h5>Blockchain Chain Visualization</h5>
                            <div class="d-flex flex-wrap">
                                @foreach (var blockGroup in Model.Transactions.Where(t => !string.IsNullOrEmpty(t.BlockHash)).GroupBy(t => t.BlockHash))
                                {
                                    <div class="card m-2" style="width: 220px;">
                                        <div class="card-header bg-info text-white p-2">
                                            <small>Block @blockGroup.Key.Substring(0, Math.Min(8, blockGroup.Key.Length))</small>
                                        </div>
                                        <div class="card-body p-2">
                                            <small>@blockGroup.Count() transaction(s)</small><br />
                                            <small>Total: KES @blockGroup.Sum(t => t.Amount).ToString("N0")</small>
                                            <div class="mt-1">
                                                @{
                                                    var allValid = blockGroup.All(t =>
                                                    Model.VerificationStatuses.ContainsKey(t.TransactionId) &&
                                                    Model.VerificationStatuses[t.TransactionId]);
                                                }
                                                @if (allValid)
                                                {
                                                    <span class="badge bg-success">All Verified</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Issues Found</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="mt-3">
                        <a href="@Url.Action("MyTransactions")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Transactions
                        </a>
                        <a href="@Url.Action("DownloadStatement")" class="btn btn-success">
                            <i class="fas fa-download"></i> Download Statement
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#auditTable').DataTable({
                pageLength: 50,
                order: [[4, 'asc']],
                searching: true,
                language: {
                    emptyTable: "No transactions found"
                }
            });
        });
    </script>
}