@model EasyBlockSupport.ViewModels.MyTransactionsViewModel

@{
    ViewData["Title"] = "My Blockchain Transactions";
}

<div class="container-fluid">
    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Transactions</h6>
                            <h2 class="mb-0">@Model.Statistics.TotalTransactions</h2>
                        </div>
                        <i class="fas fa-exchange-alt fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Amount</h6>
                            <h4 class="mb-0">KES @Model.Statistics.TotalAmount.ToString("N2")</h4>
                        </div>
                        <i class="fas fa-money-bill fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Confirmed</h6>
                            <h2 class="mb-0">@Model.Statistics.ConfirmedCount</h2>
                        </div>
                        <i class="fas fa-check-circle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Pending</h6>
                            <h2 class="mb-0">@Model.Statistics.PendingCount</h2>
                        </div>
                        <i class="fas fa-clock fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Activity Summary -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Activity Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>This Month: <span class="badge bg-primary">@Model.ActivitySummary.ThisMonth</span></h6>
                            <h6>Last Month: <span class="badge bg-secondary">@Model.ActivitySummary.LastMonth</span></h6>
                        </div>
                        <div class="col-md-6">
                            <h6>Total Contributions: <span class="badge bg-success">KES @Model.ActivitySummary.TotalContributions.ToString("N2")</span></h6>
                            <h6>Total Loans: <span class="badge bg-info">KES @Model.ActivitySummary.TotalLoans.ToString("N2")</span></h6>
                        </div>
                    </div>

                    <h6 class="mt-3">By Type:</h6>
                    <div class="row">
                        @foreach (var type in Model.ActivitySummary.ByType)
                        {
                            <div class="col-md-4">
                                <span class="badge bg-light text-dark">@type.Key: @type.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-filter"></i> Filter Transactions</h5>
                </div>
                <div class="card-body">
                    <div class="btn-group w-100" role="group">
                        <a href="@Url.Action("MyTransactions", new { filter = "all" })"
                           class="btn @(Model.CurrentFilter == "all" ? "btn-primary" : "btn-outline-primary")">
                            All
                        </a>
                        <a href="@Url.Action("MyTransactions", new { filter = "my" })"
                           class="btn @(Model.CurrentFilter == "my" ? "btn-primary" : "btn-outline-primary")">
                            My Transactions
                        </a>
                        <a href="@Url.Action("MyTransactions", new { filter = "created" })"
                           class="btn @(Model.CurrentFilter == "created" ? "btn-primary" : "btn-outline-primary")">
                            Created by Me
                        </a>
                        <a href="@Url.Action("MyTransactions", new { filter = "pending" })"
                           class="btn @(Model.CurrentFilter == "pending" ? "btn-primary" : "btn-outline-primary")">
                            Pending
                        </a>
                    </div>
                    <div class="mt-3">
                        <a href="@Url.Action("AuditTrail")" class="btn btn-info w-100">
                            <i class="fas fa-history"></i> View Audit Trail
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list"></i> Transactions</h5>
                    <div>
                        <a href="@Url.Action("DownloadStatement")" class="btn btn-sm btn-success">
                            <i class="fas fa-download"></i> Download Statement
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="transactionsTable">
                            <thead>
                                <tr>
                                    <th>Transaction ID</th>
                                    <th>Type</th>
                                    <th>Role</th>
                                    <th>Amount</th>
                                    <th>Timestamp</th>
                                    <th>Status</th>
                                    <th>Verified</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in Model.Transactions)
                                {
                                    <tr>
                                        <td><code>@tx.TransactionId.Substring(0, 8)...</code></td>
                                        <td>
                                            <span class="badge bg-info">@tx.TransactionType</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@tx.YourRole</span>
                                        </td>
                                        <td>KES @tx.Amount.ToString("N2")</td>
                                        <td>@tx.Timestamp.ToString("dd MMM HH:mm")</td>
                                        <td>
                                            @if (tx.Status == "CONFIRMED")
                                            {
                                                <span class="badge bg-success">Confirmed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            @if (tx.IsVerified)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check-circle"></i> Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-clock"></i> Pending
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action("TransactionDetails", new { transactionId = tx.TransactionId })"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-search"></i> View
                                            </a>
                                            @if (tx.CanVerify && !tx.IsVerified)
                                            {
                                                <a href="@Url.Action("Verify", new { transactionId = tx.TransactionId })"
                                                   class="btn btn-sm btn-outline-success">
                                                    <i class="fas fa-shield-alt"></i> Verify
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <nav aria-label="Page navigation" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("MyTransactions", new { page = Model.CurrentPage - 1, filter = Model.CurrentFilter })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("MyTransactions", new { page = i, filter = Model.CurrentFilter })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("MyTransactions", new { page = Model.CurrentPage + 1, filter = Model.CurrentFilter })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />

    <script>
        $(document).ready(function() {
            $('#transactionsTable').DataTable({
                pageLength: 25,
                order: [[4, 'desc']],
                searching: true,
                paging: false
            });
        });
    </script>
}